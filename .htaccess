Options -Indexes
DirectoryIndex index.php

# Bloquea el acceso web a la configuración y archivos internos
<FilesMatch "^(config(\.example)?\.php|README\.md|\.gitignore|_.*\.php)$">
    Require all denied
</FilesMatch>

# Dependencias de Composer: no accesibles desde la web
RedirectMatch 404 /vendor/
